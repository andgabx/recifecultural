/*
 * Context Mapper — Recife Cultural
 *
 * Domínio de gestão de teatros e eventos culturais em Recife.
 * Decomposição em 15 bounded contexts dentro de um único domínio
 * (`RecifeCultural`). Atualizado para refletir o código real após as
 * rodadas de implementação (acessibilidade, equipamentos, cupons,
 * auditoria persistida, notificações reais).
 *
 * Mapa rápido de integrações
 * --------------------------
 *   [PL]  Published Language via barramento de eventos
 *   [OHS] Open Host Service / chamada in-process
 *
 *   Bloqueio   --PL-->  Notificação      (EventoCanceladoPorBloqueioEvento)
 *   Bilheteria --PL-->  Catraca          (Ingresso.ReembolsadoEvento)
 *
 *   Agenda     --OHS--> Sorteio          (valida Evento APROVADO)
 *   Agenda     --OHS--> Acessibilidade   (valida Evento APROVADO)
 *   Agenda     --OHS--> Equipamento      (AlocacaoRiderTecnico le Evento)
 *   Agenda     --OHS--> Bloqueio         (cancela eventos conflitantes)
 *   Espaco     --OHS--> Bloqueio         (interdita/reativa Espaco)
 *   Espaco     --OHS--> Equipamento      (EspacoId compartilhado)
 *   Espaco     --OHS--> Agenda           (PreReserva chama Setor)
 *   Notif.     --OHS--> Sorteio | Acessibilidade | Equipamento | Espaco
 *   Cupom      --OHS--> Bilheteria       (aplicar desconto na compra)
 *   Bilheteria --OHS--> Comentario       (port BilheteriaDigital — verifica presenca)
 *   Bilheteria --OHS--> Financeiro       (DesempenhoTeatro le Ingressos)
 *   Auditoria  --OHS--> Agenda           (Decorator transparente sobre IEventoRepositorio)
 *
 * BC sem dependencia cross-context: Artista (apenas intra-BC entre modulos Artista e Produtor).
 * Patrocinio expoe dependencia OHS para AgendaContext via port IEventoParaSubsidio
 * (PatrocinioServico.ativarComSubsidio aplica desconto no Evento sem importar IEventoRepositorio).
 */
ContextMap RecifeCulturalMap {
    type = SYSTEM_LANDSCAPE
    state = AS_IS

    // ── Core / Application ─────────────────────────────────────────────
    contains AgendaContext
    contains EspacoContext
    contains BilheteriaContext
    contains PatrocinioContext
    contains FinanceiroContext
    contains ArtistaContext

    // ── Features especializadas ────────────────────────────────────────
    contains SorteioContext
    contains AcessibilidadeContext
    contains BloqueioAdministrativoContext
    contains ComentarioContext
    contains EquipamentoContext
    contains CupomContext
    contains CatracaContext

    // ── Subdomínios genéricos / suporte ────────────────────────────────
    contains NotificacaoContext
    contains AuditoriaContext

    // ════════════════════════════════════════════════════════════════════
    //  Integrações via barramento de eventos (Observer + PUBLISHED_LANGUAGE)
    // ════════════════════════════════════════════════════════════════════

    // Bloqueio publica EventoCanceladoPorBloqueioEvento no barramento;
    // BloqueioNotificacaoObservador (na camada de aplicação) reage
    // disparando notificações ao promotor e participantes do evento.
    BloqueioAdministrativoContext [U, PL] -> [D, ACL] NotificacaoContext {
        implementationTechnology = "Eventos de Domínio (ApplicationEventPublisher)"
        exposedAggregates = BloqueioAdministrativoAggregate
    }

    // Bilheteria publica ReembolsadoEvento; CatracaServicoAplicacao
    // ouve e inativa o ingresso na catraca para impedir o uso.
    BilheteriaContext [U, PL] -> [D, ACL] CatracaContext {
        implementationTechnology = "Eventos de Domínio (ApplicationEventPublisher)"
        exposedAggregates = IngressoAggregate
    }

    // ════════════════════════════════════════════════════════════════════
    //  Chamadas in-process diretas (OHS / ACL)
    // ════════════════════════════════════════════════════════════════════

    // Agenda → Sorteio: SorteioServico valida que o Evento esteja APROVADO
    // antes de permitir criar sorteio.
    AgendaContext [U, OHS] -> [D, ACL] SorteioContext {
        implementationTechnology = "Chamada de Serviço (Java in-process)"
        exposedAggregates = EventoAggregate
    }

    // Agenda → Acessibilidade: marcar recurso só em Evento APROVADO.
    AgendaContext [U, OHS] -> [D, ACL] AcessibilidadeContext {
        implementationTechnology = "Chamada de Serviço (Java in-process)"
        exposedAggregates = EventoAggregate
    }

    // Agenda → Equipamento: AlocacaoRiderTecnicoServico lê eventos para
    // alocar/desmobilizar equipamentos.
    AgendaContext [U, OHS] -> [D, ACL] EquipamentoContext {
        implementationTechnology = "Chamada de Serviço (Java in-process)"
        exposedAggregates = EventoAggregate
    }

    // Agenda → Bloqueio: BloqueioAdministrativoServico cancela eventos
    // conflitantes ao criar bloqueio.
    AgendaContext [U, OHS] -> [D, ACL] BloqueioAdministrativoContext {
        implementationTechnology = "Chamada de Serviço (Java in-process)"
        exposedAggregates = EventoAggregate
    }

    // Espaco → Bloqueio: ao criar/desativar bloqueio o serviço interdita
    // e reativa o Espaço via IEspacoRepositorio.
    EspacoContext [U, OHS] -> [D, ACL] BloqueioAdministrativoContext {
        implementationTechnology = "Chamada de Serviço (Java in-process)"
        exposedAggregates = EspacoAggregate
    }

    // Espaco → Equipamento: Equipamento referencia EspacoId como chave de
    // negócio (shared kernel implícito).
    EspacoContext [U, OHS] -> [D, ACL] EquipamentoContext {
        implementationTechnology = "Chamada de Serviço (Java in-process)"
        exposedAggregates = EspacoAggregate
    }

    // Espaco/Setor → Agenda/PreReserva: PreReservaServico orquestra
    // Setor.preReservar/liberarAssento/ocuparAssento.
    EspacoContext [U, OHS] -> [D, ACL] AgendaContext {
        implementationTechnology = "Chamada de Serviço (Java in-process)"
        exposedAggregates = SetorAggregate
    }

    // Notificação é chamada diretamente por vários serviços de domínio
    // que precisam comunicar usuários (sem passar pelo barramento):
    NotificacaoContext [U, OHS] -> [D, ACL] SorteioContext {
        implementationTechnology = "Chamada de Serviço (Java in-process)"
    }
    NotificacaoContext [U, OHS] -> [D, ACL] AcessibilidadeContext {
        implementationTechnology = "Chamada de Serviço (Java in-process)"
    }
    NotificacaoContext [U, OHS] -> [D, ACL] EquipamentoContext {
        implementationTechnology = "Chamada de Serviço (Java in-process)"
    }
    NotificacaoContext [U, OHS] -> [D, ACL] EspacoContext {
        implementationTechnology = "Chamada de Serviço (Java in-process)"
    }

    // Cupom → Bilheteria: IngressoServico chama AplicarCupomServico no
    // fluxo de compra com cupom; o desconto é aplicado antes de cobrar.
    CupomContext [U, OHS] -> [D, ACL] BilheteriaContext {
        implementationTechnology = "Chamada de Serviço (Java in-process)"
        exposedAggregates = CupomAggregate
    }

    // Bilheteria → Comentário: ComentarioService usa o port BilheteriaDigital
    // (interface em dominio-agenda) para confirmar que o autor da nota
    // de fato comprou ingresso ao evento.
    BilheteriaContext [U, OHS] -> [D, ACL] ComentarioContext {
        implementationTechnology = "Port (interface BilheteriaDigital) — adaptador na infraestrutura"
        exposedAggregates = IngressoAggregate
    }

    // Bilheteria → Financeiro: DesempenhoTeatroServico lê IIngressoRepositorio
    // para calcular receitas, ocupação e crescimento.
    BilheteriaContext [U, OHS] -> [D, ACL] FinanceiroContext {
        implementationTechnology = "Chamada de Serviço (Java in-process)"
        exposedAggregates = IngressoAggregate
    }

    // Auditoria → Agenda: relação atípica — o Decorator EventoRepositorioComAuditoria
    // está na camada de infraestrutura e *intercepta* chamadas a IEventoRepositorio,
    // gravando em IAuditoriaRepositorio. A Agenda não sabe que está sendo
    // auditada (DIP preservada).
    AuditoriaContext [U, OHS] -> [D, ACL] AgendaContext {
        implementationTechnology = "Decorator no Composition Root (envolve IEventoRepositorio)"
        exposedAggregates = RegistroAuditoriaAggregate
    }

    // Patrocínio → Agenda: quando o patrocínio do tipo SUBSIDIO_INGRESSO_SOCIAL
    // é ativado, o PatrocinioServicoAplicacao (camada de aplicação) aplica o
    // desconto no evento via port IEventoParaSubsidio (adapter no dominio-patrocinio).
    // O PatrocinioServico não depende diretamente de IEventoRepositorio —
    // recebe o port como parâmetro (DIP preservada).
    PatrocinioContext [U, OHS] -> [D, ACL] AgendaContext {
        implementationTechnology = "Port IEventoParaSubsidio — adaptador na camada de aplicação"
        exposedAggregates = PatrocinioAggregate
    }
}

Domain RecifeCultural {
    /*
     * Domínio único; a decomposição em bounded contexts segue as
     * fronteiras dos módulos Maven (`dominio-*`) e dos pacotes que
     * representam features autônomas (sorteio, acessibilidade, etc.).
     */
}

// ════════════════════════════════════════════════════════════════════════
//  AgendaContext — núcleo da plataforma
//  Pacotes Java: dominio-agenda/agenda/evento, agenda/prereserva,
//                agenda/espectador
// ════════════════════════════════════════════════════════════════════════
BoundedContext AgendaContext implements RecifeCultural {
    domainVisionStatement = "Núcleo do ciclo de vida do evento: submissão pelo produtor, aprovação ou reprovação pelo gestor, cancelamento, programação de apresentações. Inclui também a pré-reserva temporária de assentos antes do pagamento e o cadastro mínimo de espectador."
    type = APPLICATION

    Module EventoModule {
        Aggregate EventoAggregate {
            Entity Evento {
                aggregateRoot

                UUID id
                UUID promotorId
                UUID localId
                String titulo
                String descricaoCurta
                String descricaoLonga
                @Periodo periodo
                List<LocalDateTime> datasApresentacao
                List<UUID> artistas
                String categoria
                URI enderecoIngresso
                @Preco preco
                StatusEvento status
                @FeedbackReprovacao feedbackReprovacao
                LocalDateTime dataAprovacao
                LocalDateTime dataReprovacao
                boolean requerRevisaoAdicional
                String motivoCancelamento

                void marcarComoRequerRevisaoAdicional();
                void adicionarArtista(UUID artistaId);
                void definirCategoria(String categoria);
                void editarInformacoes(String titulo, String descricaoCurta, String descricaoLonga, @Periodo periodo, @Preco preco, String categoria, UUID localId, List<UUID> artistas, List<LocalDateTime> datasApresentacao);
                void submeterParaAnalise();
                void aprovar();
                void reprovar(@FeedbackReprovacao feedback);
                void cancelar(String motivo);
                void programarApresentacao(LocalDateTime dataHora);
                /* Atualiza preço social com resultado de subsídio de patrocínio (sem exigir RASCUNHO) */
                void aplicarSubsidioNoPreco(BigDecimal novoPrecoSocial);
            }

            ValueObject Periodo {
                LocalDateTime inicio
                LocalDateTime fim
            }

            ValueObject Preco {
                BigDecimal inteira
                BigDecimal meia
                /* BigDecimal (não String) — preenchido automaticamente via subsídio de patrocínio */
                BigDecimal social
            }

            ValueObject FeedbackReprovacao {
                String texto
            }

            enum StatusEvento {
                RASCUNHO, EM_ANALISE, APROVADO, REPROVADO, REALIZADO, CANCELADO
            }

            Repository IEventoRepositorio {
                void salvar(@Evento evento);
                void atualizar(@Evento evento);
                void deletar(UUID id);
                Optional<@Evento> obter(UUID id);
                List<@Evento> obterTodos();
                List<@Evento> obterPorLocalEIntervalo(UUID localId, LocalDateTime inicio, LocalDateTime fim);
                List<@Evento> obterReprovacoesPorPromotor(UUID promotorId);
                List<@Evento> obterEventosAprovadosPorPromotor(UUID promotorId);
                List<@Evento> obterEventosFinalizadosPorPromotor(UUID promotorId);
            }

            DomainService EventoServico {
                void salvar(@Evento evento);
                Optional<@Evento> obter(UUID id);
                void submeterParaAnalise(UUID id);
                void aprovar(UUID id);
                void reprovar(UUID id, @FeedbackReprovacao feedback);
                void deletar(UUID id);
                void editar(UUID id, String titulo, String descricaoCurta, String descricaoLonga, @Periodo periodo, @Preco preco, String categoria, UUID localId, List<UUID> artistas, List<LocalDateTime> datasApresentacao);
            }
        }
    }

    Module PreReservaModule {
        Aggregate PreReservaAggregate {
            Entity PreReserva {
                aggregateRoot

                @PreReservaId id
                UUID assentoId
                UUID setorId
                UUID usuarioId
                LocalDateTime criadaEm
                LocalDateTime expiraEm
                StatusPreReserva status
                int versao

                boolean estaExpirada(LocalDateTime agora);
                void expirar(LocalDateTime agora);
                void cancelar();
                void confirmar();
            }

            ValueObject PreReservaId {
                UUID valor
            }

            ValueObject DuracaoPreReserva {
                Duration valor
            }

            enum StatusPreReserva {
                ATIVA, EXPIRADA, CONVERTIDA, CANCELADA
            }

            Repository IPreReservaRepositorio {
                void salvar(@PreReserva preReserva);
                void atualizar(@PreReserva preReserva);
                Optional<@PreReserva> obterPorId(@PreReservaId id);
                List<@PreReserva> listarAtivasPorAssento(UUID assentoId);
                List<@PreReserva> listarAtivasExpiradas(LocalDateTime agora);
            }

            DomainService PreReservaServico {
                @PreReservaId reservar(UUID setorId, UUID assentoId, UUID usuarioId, @DuracaoPreReserva duracao);
                void cancelar(@PreReservaId preReservaId);
                void confirmar(@PreReservaId preReservaId);
                void expirarVencidas();
            }
        }
    }

    Module EspectadorModule {
        Aggregate EspectadorAggregate {
            Entity Espectador {
                aggregateRoot

                UUID id
                String nome
                String email
            }

            Repository EspectadorRepositorio {
                void salvar(@Espectador espectador);
                Optional<@Espectador> obter(UUID id);
                void atualizar(@Espectador espectador);
                void deletar(UUID id);
            }

            DomainService EspectadorService {
                void salvar(@Espectador espectador);
                Optional<@Espectador> obter(UUID id);
                void deletar(UUID id);
            }
        }
    }

    /*
     * Port BilheteriaDigital
     * ----------------------
     * Interface declarada em `dominio-agenda/agenda/BilheteriaDigital.java`,
     * consumida exclusivamente pelo ComentarioContext (`ComentarioService.postarComNota`)
     * para confirmar que o autor da avaliação realmente comprou ingresso. A
     * implementação concreta vive na camada de aplicação e adapta o
     * IIngressoRepositorio do BilheteriaContext — ou seja, é um adaptador
     * de fronteira (Anti-Corruption Layer entre Comentário e Bilheteria).
     *
     * Assinatura:
     *   boolean verificarPresenca(UUID espectadorId, UUID eventoId)
     */
}

// ════════════════════════════════════════════════════════════════════════
//  SorteioContext
//  Pacote Java: dominio-agenda/agenda/sorteio
// ════════════════════════════════════════════════════════════════════════
BoundedContext SorteioContext implements RecifeCultural {
    domainVisionStatement = "Distribui vagas para apresentações via sorteio aleatório, com inscrição, apuração com embaralhamento, promoção automática de suplentes em desistência e cancelamento com broadcast aos inscritos. Operações mutantes delegam ao padrão Template Method: OperacaoDominioTemplate (comum) → OperacaoSorteioTemplate → operações concretas (InscreverOperacao, ApurarOperacao, DesistirOperacao, CancelarOperacao)."
    type = APPLICATION

    Module SorteioModule {
        Aggregate SorteioAggregate {
            Entity Sorteio {
                aggregateRoot

                UUID id
                UUID apresentacaoId
                UUID eventoId
                int vagas
                LocalDateTime prazoInscricao
                LocalDateTime dataApresentacao
                StatusSorteio status
                List<@Inscricao> inscricoes

                void inscrever(UUID espectadorId);
                /* Retorna ConcluidoEvento (domain event) com ganhadores e suplentes definidos */
                ConcluidoEvento apurar();
                /* Retorna Optional<SuplentePromovidoEvento> — promove primeiro suplente se ganhador desiste */
                Optional<SuplentePromovidoEvento> desistir(UUID espectadorId);
                /* Retorna CanceladoEvento (domain event) */
                CanceladoEvento cancelar();
                long contarPorStatus(StatusInscricao status);
            }

            Entity Inscricao {
                UUID espectadorId
                LocalDateTime momentoInscricao
                StatusInscricao status
            }

            enum StatusInscricao {
                INSCRITO, GANHADOR, SUPLENTE, DESISTENTE, CANCELADA
            }

            enum StatusSorteio {
                INSCRICOES_ABERTAS, EM_APURACAO, CONCLUIDO, CANCELADO
            }

            Repository ISorteioRepositorio {
                void salvar(@Sorteio sorteio);
                Optional<@Sorteio> obter(UUID id);
                void atualizar(@Sorteio sorteio);
                void deletar(UUID id);
            }

            DomainService SorteioServico {
                @Sorteio criar(UUID apresentacaoId, UUID eventoId, int vagas, LocalDateTime prazoInscricao, LocalDateTime dataApresentacao);
                /* Delega a InscreverOperacao.executar() — Template Method */
                void inscrever(UUID sorteioId, UUID espectadorId);
                /* Delega a ApurarOperacao.executar() — Template Method; notifica ganhadores */
                void apurar(UUID sorteioId);
                /* Delega a DesistirOperacao.executar() — Template Method; notifica suplente promovido */
                void desistir(UUID sorteioId, UUID espectadorId);
                /* Delega a CancelarOperacao.executar() — Template Method; broadcast SORTEIO_CANCELADO */
                void cancelar(UUID sorteioId);
                Optional<@Sorteio> obter(UUID id);
            }
        }
    }

    /*
     * Padrão Template Method — hierarquia de operações (pacote sorteio/):
     *
     *   OperacaoDominioTemplate<T>       (pacote comum/)
     *     executar() [final]: buscar() → aplicarRegra() → persistir() → notificar()
     *     buscar(), aplicarRegra(), persistir() [abstratos]
     *     notificar() [hook — no-op por padrão]
     *
     *   OperacaoSorteioTemplate          extends OperacaoDominioTemplate<Sorteio>
     *     buscar(): sorteioRepositorio.obter(sorteioId)
     *     persistir(): sorteioRepositorio.atualizar(sorteio)
     *     Campos: ISorteioRepositorio, INotificacaoServico, UUID sorteioId
     *
     *   InscreverOperacao  extends OperacaoSorteioTemplate
     *     aplicarRegra(): sorteio.inscrever(espectadorId)
     *     (sem notificação)
     *
     *   ApurarOperacao     extends OperacaoSorteioTemplate
     *     aplicarRegra(): sorteio.apurar()
     *     notificar(): envia SORTEIO_GANHADOR a cada inscrição com status GANHADOR
     *
     *   DesistirOperacao   extends OperacaoSorteioTemplate
     *     aplicarRegra(): this.promocao = sorteio.desistir(espectadorId)
     *     notificar(): se promocao presente, envia SORTEIO_PROMOCAO ao suplente promovido
     *
     *   CancelarOperacao   extends OperacaoSorteioTemplate
     *     aplicarRegra(): sorteio.cancelar()
     *     notificar(): enviarBroadcast SORTEIO_CANCELADO
     */
}

// ════════════════════════════════════════════════════════════════════════
//  BloqueioAdministrativoContext
//  Pacote Java: dominio-agenda/agenda/bloqueioadministrativo
// ════════════════════════════════════════════════════════════════════════
BoundedContext BloqueioAdministrativoContext implements RecifeCultural {
    domainVisionStatement = "Interdita um espaço por período (manutenção emergencial, reforma, vistoria). Ao ser criado: interdita o Espaço, cancela eventos APROVADOS que se sobrepõem ao intervalo e publica EventoCanceladoPorBloqueioEvento no barramento para que o observador de notificações avise promotor e participantes."
    type = CORE_DOMAIN

    Module BloqueioAdministrativoModule {
        Aggregate BloqueioAdministrativoAggregate {
            Entity BloqueioAdministrativo {
                aggregateRoot

                @BloqueioAdministrativoId id
                @EspacoId espacoId
                LocalDate dataInicio
                LocalDate dataFim
                String justificativa
                boolean ativo
                /* Rastreia quais eventos foram cancelados por este bloqueio */
                List<UUID> eventosCancelados

                void atualizarInformacoes(String novaJustificativa, LocalDate novoInicio, LocalDate novoFim);
                void desativar();
                /* Registra um eventoCancelado na lista interna — chamado durante cancelarEventosConflitantes */
                void registrarEventoCancelado(UUID eventoId);
            }

            ValueObject BloqueioAdministrativoId {
                UUID valor
            }

            Repository IBloqueioAdministrativoRepositorio {
                void salvar(@BloqueioAdministrativo bloqueio);
                @BloqueioAdministrativo obter(@BloqueioAdministrativoId id);
                void atualizar(@BloqueioAdministrativo bloqueio);
                void deletar(@BloqueioAdministrativoId id);
                List<@BloqueioAdministrativo> obterTodos();
                List<@BloqueioAdministrativo> buscarPorEspaco(@EspacoId espacoId);
            }

            DomainService BloqueioAdministrativoServico {
                @BloqueioAdministrativo criarBloqueio(@EspacoId espacoId, LocalDate inicio, LocalDate fim, String justificativa);
                /* boolean reativarEventos — controla se eventos cancelados são reativados ao desbloquear */
                void desativarBloqueio(@BloqueioAdministrativoId id, boolean reativarEventos);
                /* Desativa todos os bloqueios ativos de um espaço (usado ao reativar espaço interditado) */
                void desativarBloqueiosAtivosDoEspaco(@EspacoId espacoId);
                @BloqueioAdministrativo obterPorId(@BloqueioAdministrativoId id);
                void atualizarBloqueio(@BloqueioAdministrativoId id, String novaJustificativa, LocalDate novoInicio, LocalDate novoFim);
                void deletarBloqueio(@BloqueioAdministrativoId id);
                List<@BloqueioAdministrativo> obterTodosBloqueios();
                /* Retorna eventos que conflitariam com o novo bloqueio — usado na UI antes de confirmar */
                List<Evento> previewConflitantes(@EspacoId espacoId, LocalDate inicio, LocalDate fim);
            }
        }
    }
}

// ════════════════════════════════════════════════════════════════════════
//  ComentarioContext
//  Pacote Java: dominio-agenda/agenda/comentario
// ════════════════════════════════════════════════════════════════════════
BoundedContext ComentarioContext implements RecifeCultural {
    domainVisionStatement = "Permite que espectadores discutam e avaliem eventos: comentários com curtidas, respostas em árvore (comentarioPaiId), notas (1-5) restritas a quem comprou ingresso. Moderação automática via Decorator que substitui palavras vetadas antes de persistir."
    type = FEATURE

    Module ComentarioModule {
        Aggregate ComentarioAggregate {
            Entity Comentario {
                aggregateRoot

                UUID id
                UUID espectadorId
                UUID eventoId
                UUID comentarioPaiId
                LocalDateTime criadoEm
                String texto
                @Nota nota
                StatusComentario status
                Set<UUID> curtidas

                void curtir(UUID espectadorId);
                void editar(String novoTexto);
                void deletar();
            }

            ValueObject Nota {
                int valor
            }

            enum StatusComentario {
                ATIVO, DELETADO
            }

            Repository ComentarioRepositorio {
                void salvar(@Comentario comentario);
                void atualizar(@Comentario comentario);
                Optional<@Comentario> obter(UUID id);
                void deletar(UUID id);
                List<@Comentario> listarPorEvento(UUID eventoId);
                boolean existeNotaPorEspectador(UUID espectadorId, UUID eventoId);
            }

            DomainService ComentarioService {
                void postar(@Comentario comentario);
                /*
                 * Recebe `BilheteriaDigital` (port declarado em
                 * AgendaContext / dominio-agenda) como dependência —
                 * verifica que o espectador esteve presente antes de
                 * aceitar a nota.
                 */
                void postarComNota(@Comentario comentario, BilheteriaDigital bilheteria);
                void curtir(UUID comentarioId, UUID espectadorId);
                void responder(UUID comentarioPaiId, @Comentario resposta);
                void editar(UUID id, String novoTexto);
                void deletar(UUID id);
                List<@Comentario> listarAtivos(UUID eventoId);
                Optional<@Comentario> obter(UUID id);
            }
        }
    }
}

// ════════════════════════════════════════════════════════════════════════
//  AcessibilidadeContext
//  Pacote Java: dominio-agenda/agenda/acessibilidade
// ════════════════════════════════════════════════════════════════════════
BoundedContext AcessibilidadeContext implements RecifeCultural {
    domainVisionStatement = "Marca recursos de acessibilidade confirmados por apresentação (LIBRAS, audiodescrição, legenda descritiva, espaço PCD, programa em braile). Exige Evento APROVADO para marcação e justificativa de no mínimo 30 caracteres para remoção, que dispara broadcast público via padrão Template Method: OperacaoDominioTemplate (comum) → OperacaoRecursoAcessibilidadeTemplate → RemocaoRecursoAcessibilidadeOperacao."
    type = APPLICATION

    Module AcessibilidadeModule {
        Aggregate RecursoAcessibilidadeAggregate {
            Entity RecursoAcessibilidade {
                aggregateRoot

                UUID id
                UUID apresentacaoId
                UUID eventoId
                TipoRecursoAcessibilidade tipo
                StatusRecurso status
                String justificativaRemocao

                /* Retorna RemovidoEvento (domain event) — emite para acionar broadcast de notificação */
                void remover(String justificativa);
            }

            enum TipoRecursoAcessibilidade {
                LIBRAS, AUDIODESCRICAO, LEGENDA_DESCRITIVA, ESPACO_PCD, PROGRAMA_BRAILE
            }

            enum StatusRecurso {
                CONFIRMADO, REMOVIDO
            }

            Repository IRecursoAcessibilidadeRepositorio {
                void salvar(@RecursoAcessibilidade recurso);
                Optional<@RecursoAcessibilidade> obter(UUID id);
                List<@RecursoAcessibilidade> listarPorApresentacao(UUID apresentacaoId);
                List<@RecursoAcessibilidade> listarAtivosPorEvento(UUID eventoId);
                List<@RecursoAcessibilidade> listarPorEvento(UUID eventoId);
                List<@RecursoAcessibilidade> listarTodos();
                void atualizar(@RecursoAcessibilidade recurso);
            }

            DomainService RecursoAcessibilidadeServico {
                @RecursoAcessibilidade marcar(UUID apresentacaoId, UUID eventoId, TipoRecursoAcessibilidade tipo);
                /* Delega a RemocaoRecursoAcessibilidadeOperacao.executar() — Template Method; broadcast ACESSIBILIDADE_REMOVIDA */
                void remover(UUID recursoId, String justificativa);
                List<@RecursoAcessibilidade> listarAtivosPorEvento(UUID eventoId);
            }
        }
    }

    /*
     * Padrão Template Method — hierarquia de operações (pacote acessibilidade/):
     *
     *   OperacaoDominioTemplate<T>                   (pacote comum/)
     *     executar() [final]: buscar() → aplicarRegra() → persistir() → notificar()
     *     buscar(), aplicarRegra(), persistir() [abstratos]
     *     notificar() [hook — no-op por padrão]
     *
     *   OperacaoRecursoAcessibilidadeTemplate         extends OperacaoDominioTemplate<RecursoAcessibilidade>
     *     buscar(): repositorio.obter(recursoId)
     *     persistir(): repositorio.atualizar(recurso)
     *     Campos: IRecursoAcessibilidadeRepositorio, INotificacaoServico, UUID recursoId
     *
     *   RemocaoRecursoAcessibilidadeOperacao          extends OperacaoRecursoAcessibilidadeTemplate
     *     aplicarRegra(): recurso.remover(justificativa)
     *     notificar(): enviarBroadcast ACESSIBILIDADE_REMOVIDA com tipo e eventoId
     */
}

// ════════════════════════════════════════════════════════════════════════
//  EquipamentoContext
//  Pacote Java: dominio-agenda/agenda/equipamento
// ════════════════════════════════════════════════════════════════════════
BoundedContext EquipamentoContext implements RecifeCultural {
    domainVisionStatement = "Inventário técnico de cada espaço: aquisição, alocação para rider de eventos, manutenção (com notificação ao evento alocado), liberação e desmobilização. Inclui serviço que aloca múltiplos equipamentos por nome."
    type = APPLICATION

    Module EquipamentoModule {
        Aggregate EquipamentoAggregate {
            Entity Equipamento {
                aggregateRoot

                @EquipamentoId id
                @EspacoId espacoId
                String nome
                StatusEquipamento status
                UUID eventoAlocadoId

                void alocarParaEvento(UUID eventoId);
                /* Retorna Optional<EmManutencaoEvento> — emitido apenas se estava ALOCADO (contém eventoAlocadoId) */
                void enviarParaManutencao();
                void liberar();
            }

            ValueObject EquipamentoId {
                UUID valor
            }

            enum StatusEquipamento {
                DISPONIVEL, ALOCADO, EM_MANUTENCAO
            }

            Repository IEquipamentoRepositorio {
                void salvar(@Equipamento equipamento);
                void atualizar(@Equipamento equipamento);
                void deletar(@EquipamentoId id);
                Optional<@Equipamento> obterPorId(@EquipamentoId id);
                List<@Equipamento> listarPorEspaco(@EspacoId espacoId);
                List<@Equipamento> buscarDisponiveisPorEspacoENome(@EspacoId espacoId, String nome, int quantidade);
                List<@Equipamento> buscarAlocadosPorEvento(UUID eventoId);
            }

            DomainService EquipamentoServico {
                @EquipamentoId adquirirEquipamento(@EspacoId espacoId, String nome);
                void reportarManutencao(@EquipamentoId id);
                void removerEquipamento(@EquipamentoId id);
                void liberar(@EquipamentoId id);
            }

            DomainService AlocacaoRiderTecnicoServico {
                void alocarEquipamentos(UUID eventoId, @EspacoId espacoId, String nomeEquipamento, int quantidadeNecessaria);
                void registrarManutencao(@EquipamentoId id);
                void desmobilizarEquipamentosDoEvento(UUID eventoId);
            }
        }
    }
}

// ════════════════════════════════════════════════════════════════════════
//  EspacoContext
//  Pacotes Java: dominio-espaco/espaco/espaco, espaco/setor, espaco/suporte
// ════════════════════════════════════════════════════════════════════════
BoundedContext EspacoContext implements RecifeCultural {
    domainVisionStatement = "Cadastro e operação dos espaços culturais físicos: capacidade máxima, rider técnico, status (ATIVO/INTERDITADO), ocupações com buffers de montagem/desmontagem, gestão da planta interna (setores e assentos) e atendimento a chamados de suporte técnico."
    type = APPLICATION

    Module EspacoModule {
        Aggregate EspacoAggregate {
            Entity Espaco {
                aggregateRoot

                @EspacoId id
                String nome
                int capacidadeMaxima
                List<String> riderTecnico
                StatusEspaco status
                List<@Ocupacao> ocupacoesExistentes

                void reduzirCapacidade(int novaCapacidade, int maiorCargaIngressosVendidosFuturo);
                void interditar();
                void reativar();
                void validarDisponibilidade(@Ocupacao novaOcupacao, List<@Ocupacao> ocupacoesNoPeriodo);
            }

            ValueObject EspacoId {
                UUID valor
            }

            ValueObject Ocupacao {
                LocalDateTime inicio
                LocalDateTime fim
                int minutosMontagem
                int minutosDesmontagem
                int bufferExtra
            }

            enum StatusEspaco {
                ATIVO, INTERDITADO
            }

            Repository IEspacoRepositorio {
                void salvar(@Espaco espaco);
                void atualizar(@Espaco espaco);
                Optional<@Espaco> obterPorId(@EspacoId id);
                List<@Espaco> listarTodos();
                List<@Ocupacao> buscarOcupacoesPorPeriodo(@EspacoId id, LocalDateTime inicio, LocalDateTime fim);
                void salvarOcupacao(@EspacoId id, @Ocupacao ocupacao);
            }

            DomainService EspacoServico {
                @EspacoId cadastrarEspaco(String nome, int capacidadeMaxima, List<String> riderTecnico);
                List<@Espaco> listarTodos();
                void atualizarCapacidade(@EspacoId id, int novaCapacidade, int ingressosVendidosFuturos);
                void interditarEspaco(@EspacoId id);
                void agendarEvento(@EspacoId id, @Ocupacao novaOcupacao);
            }
        }
    }

    Module SetorModule {
        Aggregate SetorAggregate {
            Entity Setor {
                aggregateRoot

                @SetorId id
                @EspacoId espacoId
                String nome
                TipoSetor tipoSetor
                int fileirasHorizontais
                int assentosPorFileiraVertical
                List<@Assento> assentos
                int versao

                void mapearAssentos(List<@Assento> novosAssentos);
                @Assento preReservar(UUID assentoId);
                @Assento liberarAssento(UUID assentoId);
                @Assento ocuparAssento(UUID assentoId);
                @Assento bloquearAssento(UUID assentoId, MotivoIndisponibilidadeAssento motivo);
                int capacidade();
                long contarAssentosDisponiveis();
                boolean editar(String novoNome, TipoSetor novoTipo, int novasFileiras, int novosAssentosPorFileira);
            }

            Entity Assento {
                UUID id
                String codigo
                String fileira
                int numero
                StatusAssento status
                MotivoIndisponibilidadeAssento motivoIndisponibilidade
                int versao

                void marcarPreReservado();
                void liberar();
                void ocupar();
                void bloquear(MotivoIndisponibilidadeAssento motivo);
            }

            ValueObject SetorId {
                UUID valor
            }

            enum TipoSetor {
                PLATEIA, CAMAROTE, BALCAO, PISTA
            }

            enum StatusAssento {
                LIVRE, PRE_RESERVADO, OCUPADO, BLOQUEADO
            }

            enum MotivoIndisponibilidadeAssento {
                QUEBRADO, MANUTENCAO, RESERVADO_VIP, PONTO_CEGO, OUTRO
            }

            Repository ISetorRepositorio {
                void salvar(@Setor setor);
                void atualizar(@Setor setor);
                Optional<@Setor> obterPorId(@SetorId id);
                List<@Setor> listarPorEspaco(@EspacoId espacoId);
            }

            DomainService GestaoAmbienteInternoServico {
                @Setor configurarGestaoAmbiente(@EspacoId espacoId, String nome, TipoSetor tipoSetor, int fileirasHorizontais, int assentosPorFileiraVertical);
                @Setor editarSetor(@SetorId id, String nome, TipoSetor tipoSetor, int fileirasHorizontais, int assentosPorFileiraVertical);
                long contarAssentosDisponiveisPorEspaco(@EspacoId espacoId);
                List<@Setor> listarPorEspaco(@EspacoId espacoId);
            }
        }
    }

    Module SuporteTecnicoModule {
        Aggregate ChamadoSuporteAggregate {
            Entity ChamadoSuporte {
                aggregateRoot

                UUID id
                UUID assentoId
                String descricao
                MotivoIndisponibilidadeAssento motivo
                StatusChamado status
                LocalDateTime dataAbertura

                void resolver();
                void escalar();
            }

            enum StatusChamado {
                ABERTO, EM_ANDAMENTO, ESCALADO, RESOLVIDO
            }

            Repository IChamadoSuporteRepositorio {
                void salvar(@ChamadoSuporte chamado);
                void atualizar(@ChamadoSuporte chamado);
                Optional<@ChamadoSuporte> obterPorId(UUID id);
                List<@ChamadoSuporte> listarAbertosAntesDe(LocalDateTime limite);
            }

            DomainService SuporteTecnicoServico {
                @ChamadoSuporte abrirChamado(@SetorId setorId, UUID assentoId, MotivoIndisponibilidadeAssento motivo, String descricao);
                void escalarVencidos(LocalDateTime agora, long slaHoras);
            }
        }
    }
}

// ════════════════════════════════════════════════════════════════════════
//  BilheteriaContext (Ingressos)
//  Pacote Java: dominio-ingressos/ingressos
// ════════════════════════════════════════════════════════════════════════
BoundedContext BilheteriaContext implements RecifeCultural {
    domainVisionStatement = "Venda de ingressos, geração de QR code, integração com gateway de pagamento e reembolso escalonado por proximidade da data. Suporta compra com pré-reserva, compra com cupom e reembolso assíncrono (que publica ReembolsadoEvento para invalidar o ingresso na Catraca)."
    type = APPLICATION

    Module IngressoModule {
        Aggregate IngressoAggregate {
            Entity Ingresso {
                aggregateRoot

                @IngressoId id
                UUID eventoId
                UUID assentoId
                LocalDateTime dataHoraApresentacao
                TipoIngresso tipo
                StatusIngresso status
                BigDecimal valorPago
                String codigoQr
                String codigoTransacao
                MetodoPagamento metodoPagamento
                LocalDateTime dataCompra
                BigDecimal valorReembolsado

                BigDecimal calcularReembolso(LocalDateTime agora);
                void reembolsar(BigDecimal valor);
                void marcarComoUtilizado();
            }

            ValueObject IngressoId {
                UUID valor
            }

            ValueObject ResultadoPagamento {
                String codigoTransacao
                boolean aprovado
            }

            ValueObject ResultadoReembolso {
                BigDecimal valorReembolsado
                boolean processado
                String prazoProcessamento
            }

            enum TipoIngresso {
                INTEIRA, MEIA_ENTRADA, SOCIAL
            }

            enum StatusIngresso {
                ATIVO, REEMBOLSADO, UTILIZADO
            }

            enum MetodoPagamento {
                CARTAO_CREDITO, PIX
            }

            Repository IIngressoRepositorio {
                void salvar(@Ingresso ingresso);
                @Ingresso buscarPorId(@IngressoId id);
                @Ingresso buscarPorCodigoQr(String codigoQr);
                int contarAtivosPorApresentacao(UUID eventoId, LocalDateTime dataHora);
                List<@Ingresso> buscarPorPeriodo(LocalDateTime inicio, LocalDateTime fim);
            }

            DomainService IngressoServico {
                @Ingresso comprar(UUID eventoId, LocalDateTime dataHora, TipoIngresso tipo, BigDecimal valor, MetodoPagamento metodo, int capacidadeMaxima);
                @Ingresso comprarComCupom(UUID eventoId, LocalDateTime dataHora, TipoIngresso tipo, BigDecimal valor, MetodoPagamento metodo, int capacidadeMaxima, String codigoCupom, String cpfComprador, String categoriaEvento);
                @Ingresso comprarComPreReserva(UUID eventoId, LocalDateTime dataHora, UUID preReservaId, UUID assentoId, TipoIngresso tipo, BigDecimal valor, MetodoPagamento metodo, int capacidadeMaxima, IConfirmacaoReserva confirmacaoReserva);
                /* Combinação: pré-reserva + cupom em uma única operação */
                @Ingresso comprarComPreReservaComCupom(UUID eventoId, LocalDateTime dataHora, UUID preReservaId, UUID assentoId, TipoIngresso tipo, BigDecimal valor, MetodoPagamento metodo, int capacidadeMaxima, String codigoCupom, String cpfComprador, String categoriaEvento, IConfirmacaoReserva confirmacaoReserva);
                @ResultadoReembolso solicitarReembolso(@IngressoId id, LocalDateTime agora);
            }
        }

        /*
         * Ports (interfaces no domínio, implementações na infraestrutura):
         *   IGatewayPagamento    — processa cobrança e reembolso
         *   IConfirmacaoReserva  — confirma/cancela pré-reserva no fluxo de compra
         *
         * Padrão Strategy — Política de Reembolso por Método de Pagamento
         * (vive no dominio-ingressos, NÃO na infraestrutura):
         *   EstrategiaProcessamentoReembolso  — interface: prazoProcessamento() + descricao() + aplicavelA()
         *   EstrategiaReembolsoImediato       — PIX: devolução na hora
         *   EstrategiaReembolsoBancario       — Cartão: até 2 dias úteis
         *   SeletorEstrategiaReembolso        — Context: seleciona por MetodoPagamento
         * Consumidas por MeusIngressosControlador (BFF) para exibir a política antes de confirmar.
         */
    }
}

// ════════════════════════════════════════════════════════════════════════
//  CupomContext
//  Pacote Java: dominio-ingressos/cupom
// ════════════════════════════════════════════════════════════════════════
BoundedContext CupomContext implements RecifeCultural {
    domainVisionStatement = "Gerencia cupons promocionais. A validação usa Decorator em cadeia: ValidarVigencia → ValidarMinimo → ValidarCategoria → ValidarEscassezGlobal → ValidarLimiteCpf → ValidadorBase. Suporta desconto percentual ou valor fixo. Dois modos: previewDesconto (sem consumir) e aplicarDesconto (registra uso)."
    type = FEATURE

    Module CupomModule {
        Aggregate CupomAggregate {
            Entity Cupom {
                aggregateRoot

                @CupomId id
                String codigo
                TipoDesconto tipoDesconto
                BigDecimal valorDesconto
                BigDecimal valorMinimoPedido
                int limiteGlobal
                int usosGlobais
                int limitePorCpf
                LocalDateTime dataInicio
                LocalDateTime dataFim
                String categoriaPermitida
                Set<String> cpfsQueJaUsaram

                BigDecimal calcularDesconto(BigDecimal valorOriginal);
                /* Parâmetro validador recebe a cadeia de Decorators montada em AplicarCupomServico */
                void validarElegibilidade(String cpfUsuario, BigDecimal valorPedido, String categoriaEvento, LocalDateTime dataAtual, ValidadorCupom validador);
                void registrarUso(String cpfUsuario);
            }

            /*
             * Padrão Decorator — Pipeline de validação (pacote dominio-ingressos/cupom/validacoes/):
             *   ValidadorCupom (interface)         — void validar(Cupom, cpf, valorPedido, categoriaEvento, dataAtual)
             *   ValidadorCupomBase                 — implementação vazia (núcleo)
             *   ValidadorCupomDecorator (abstrato) — delega ao interno antes de validar
             *   ValidarVigenciaDecorator           — dataInicio ≤ agora ≤ dataFim
             *   ValidarMinimoDecorator             — valorPedido ≥ valorMinimoPedido
             *   ValidarCategoriaDecorator          — categoriaPermitida == null OU bate
             *   ValidarEscassezGlobalDecorator     — usosGlobais < limiteGlobal
             *   ValidarLimiteCpfDecorator          — usos do CPF < limitePorCpf
             * Pipeline montado no construtor de AplicarCupomServico (fora→dentro).
             */

            ValueObject CupomId {
                String valor
            }

            enum TipoDesconto {
                PERCENTUAL, VALOR_FIXO
            }

            Repository ICupomRepositorio {
                @Cupom buscarPorCodigo(String codigo);
                @Cupom buscarPorId(@CupomId id);
                List<@Cupom> listarTodos();
                void salvar(@Cupom cupom);
                void deletar(@CupomId id);
            }

            DomainService AplicarCupomServico {
                /* Valida, aplica e registra uso — usar apenas na finalização da compra */
                BigDecimal aplicarDesconto(String codigo, String cpf, BigDecimal valor, String categoria);
                /* Valida e calcula SEM registrar uso — usar para preview antes de confirmar */
                PreviewDesconto previewDesconto(String codigo, String cpf, BigDecimal valor, String categoria);
            }
        }
    }
}

// ════════════════════════════════════════════════════════════════════════
//  CatracaContext
//  Pacote Java: dominio-ingressos/catraca
// ════════════════════════════════════════════════════════════════════════
BoundedContext CatracaContext implements RecifeCultural {
    domainVisionStatement = "Controle físico de acesso na portaria. Usa Decorator pipeline anti-fraude em validarAcesso: ValidarEstorno → ValidarDuplaEntrada → ValidarPortao → ValidarToleranciaAtraso → ValidadorAcessoBase. Recebe ReembolsadoEvento da Bilheteria para inativar ingressos reembolsados antes que entrem."
    type = FEATURE

    Module CatracaModule {
        Aggregate CatracaAggregate {
            Entity IngressoCatraca {
                aggregateRoot

                @IngressoCatracaId id
                String idEvento
                StatusIngressoCatraca status
                LocalDateTime horarioInicioEvento
                TipoIngresso tipoIngresso
                String portaoAcesso

                void registrarEntrada(LocalDateTime horarioLeituraCatraca, String portaoDaCatracaFisica);
                void cancelarAcesso();
            }

            ValueObject IngressoCatracaId {
                String valor
            }

            enum StatusIngressoCatraca {
                VALIDO, UTILIZADO, CANCELADO_OU_REEMBOLSADO
            }

            enum TipoIngresso {
                COMUM, VIP, MEIA_ENTRADA
            }

            Repository ICatracaRepositorio {
                @IngressoCatraca buscarPorId(String idIngresso);
                void salvar(@IngressoCatraca ingressoCatraca);
            }

            DomainService CatracaServico {
                String validarAcesso(String idIngresso, LocalDateTime horarioAtual, String identificacaoPortao);
                void inativarIngresso(String idIngresso);
            }

            /*
             * Padrão Decorator — Pipeline de validação de acesso
             * (pacote dominio-ingressos/catraca/validacoes/):
             *   ValidadorAcesso (interface)          — void validar(IngressoCatraca, LocalDateTime, String)
             *   ValidadorAcessoBase                  — núcleo sem lógica
             *   ValidadorAcessoDecorator (abstrato)  — delega ao interno
             *   ValidarEstornoDecorator              — rejeita se CANCELADO_OU_REEMBOLSADO
             *   ValidarDuplaEntradaDecorator         — rejeita se UTILIZADO
             *   ValidarPortaoDecorator               — rejeita se portão errado
             *   ValidarToleranciaAtrasoDecorator     — rejeita COMUM com mais de 15 min de atraso após horarioInicioEvento
             * Pipeline montado no construtor de CatracaServico (fora→dentro).
             */
        }
    }
}

// ════════════════════════════════════════════════════════════════════════
//  PatrocinioContext
//  Pacote Java: dominio-patrocinio/patrocinio
// ════════════════════════════════════════════════════════════════════════
BoundedContext PatrocinioContext implements RecifeCultural {
    domainVisionStatement = "Vincula patrocinadores a eventos aprovados controlando: exclusividade por categoria, naming rights para o tipo MASTER, cancelamentos com reembolso escalonado (Strategy: por evento vs por patrocinador) e subsídio de ingresso social com piso mínimo. BC isolado — não importa o Evento; recebe apenas o boolean eventoAprovado do caller."
    type = APPLICATION

    Module PatrocinioModule {
        Aggregate PatrocinioAggregate {
            Entity Patrocinio {
                aggregateRoot

                @PatrocinioId id
                @EventoId eventoId
                String patrocinadorNome
                String categoriaPatrocinio
                TipoPatrocinio tipo
                ModalidadeContribuicao modalidade
                BigDecimal valorContribuicao
                LocalDateTime dataEvento
                StatusPatrocinio status
                BigDecimal valorReembolsado
                BigDecimal multaAplicada

                void ativar();
                void encerrar();
                /*
                 * Os métodos `cancelar*` emitem um Patrocinio.CanceladoEvento
                 * (inner Domain Event com reembolso, multa e motivo). O service
                 * converte isso para um @ResultadoCancelamento exposto à camada
                 * de aplicação.
                 */
                void cancelar(EstrategiaCancelamentoPatrocinio estrategia, LocalDateTime agora);
                void cancelarPorEvento(LocalDateTime agora);
                void cancelarPorPatrocinador(LocalDateTime agora);
                @ResultadoSubsidio calcularSubsidio(BigDecimal precoSocialAtual);
            }

            ValueObject PatrocinioId { UUID valor }

            /*
             * VO local ao BC — não compartilha tipo com agenda/evento; o
             * Patrocínio recebe o id do evento como dado de fronteira.
             */
            ValueObject EventoId { UUID valor }

            ValueObject ResultadoCalculoCancelamento {
                BigDecimal reembolso
                BigDecimal multa
                String motivo
            }

            ValueObject ResultadoCancelamento {
                BigDecimal valorReembolsado
                BigDecimal multaAplicada
                String motivo
            }

            ValueObject ResultadoSubsidio {
                BigDecimal novoPrecoSocial
                boolean pisoAplicado
            }

            enum TipoPatrocinio {
                MASTER, ASSOCIADO
            }

            enum StatusPatrocinio {
                PROPOSTA, ATIVO, ENCERRADO, CANCELADO_EVENTO, CANCELADO_PATROCINADOR
            }

            enum ModalidadeContribuicao {
                FINANCEIRO, SUBSIDIO_INGRESSO_SOCIAL
            }

            /*
             * Padrão Strategy (vivo no domínio):
             *   EstrategiaCancelamentoPatrocinio — abstração
             *   EstrategiaCancelamentoPorEvento  — >7d: 100% · 2-7d: 50% · <2d: 0%
             *   EstrategiaCancelamentoPorPatrocinador — >15d: 100% · ≤15d: 80% + 20% multa
             *
             * Port IEventoParaSubsidio (declarado em dominio-patrocinio):
             *   Permite que PatrocinioServico.ativarComSubsidio() aplique o desconto
             *   no Evento sem depender diretamente de IEventoRepositorio.
             *   Implementado na camada de aplicação (PatrocinioServicoAplicacao) como adapter.
             *   Métodos: getPrecoInteiro() + aplicarSubsidioNoPreco(BigDecimal)
             */

            Repository IPatrocinioRepositorio {
                void salvar(@Patrocinio patrocinio);
                @Patrocinio buscarPorId(@PatrocinioId id);
                List<@Patrocinio> buscarPorEvento(@EventoId eventoId);
                Optional<@Patrocinio> buscarMasterPorEvento(@EventoId eventoId);
                Optional<@Patrocinio> buscarPorEventoECategoria(@EventoId eventoId, String categoria);
                void atualizar(@Patrocinio patrocinio);
            }

            DomainService PatrocinioServico {
                @Patrocinio criar(@EventoId eventoId, String patrocinadorNome, String categoriaPatrocinio, TipoPatrocinio tipo, ModalidadeContribuicao modalidade, BigDecimal valorContribuicao, LocalDateTime dataEvento, boolean eventoAprovado);
                /* Transição simples PROPOSTA → ATIVO sem subsídio */
                void ativar(@PatrocinioId id);
                /* Ativa E aplica subsídio no evento via IEventoParaSubsidio (retorna null se modalidade FINANCEIRO) */
                @ResultadoSubsidio ativarComSubsidio(@PatrocinioId id, IEventoParaSubsidio evento);
                void encerrar(@PatrocinioId id);
                @ResultadoCancelamento cancelarPorEvento(@PatrocinioId id, LocalDateTime agora);
                @ResultadoCancelamento cancelarPorPatrocinador(@PatrocinioId id, LocalDateTime agora);
                @ResultadoSubsidio calcularSubsidio(@PatrocinioId id, BigDecimal precoSocialAtual);
                @Patrocinio obterPorId(@PatrocinioId id);
            }
        }
    }
}

// ════════════════════════════════════════════════════════════════════════
//  FinanceiroContext
//  Pacote Java: dominio-financeiro/financeiro
// ════════════════════════════════════════════════════════════════════════
BoundedContext FinanceiroContext implements RecifeCultural {
    domainVisionStatement = "Controle orçamentário por período, registro de despesas operacionais com alerta de 80% do orçamento e cálculo de indicadores de desempenho (receita bruta/líquida, ocupação, crescimento de público) — esses indicadores leem ingressos para apurar a receita."
    type = APPLICATION

    Module FinanceiroModule {
        Aggregate OrcamentoAggregate {
            Entity OrcamentoPeriodo {
                aggregateRoot

                @OrcamentoId id
                @Periodo periodo
                BigDecimal valorTotal
                StatusOrcamento status

                void reduzir(BigDecimal novoValor, BigDecimal totalDespesasRegistradas);
                void encerrar();
            }

            ValueObject OrcamentoId {
                UUID valor
            }

            ValueObject Periodo {
                LocalDateTime dataInicio
                LocalDateTime dataFim

                /* Método Java real: contem() — verifica se dataHora está dentro do período */
                boolean contem(LocalDateTime dataHora);
                boolean sobrepoe(@Periodo outro);
            }

            enum StatusOrcamento {
                ABERTO, ENCERRADO
            }

            Repository IOrcamentoRepositorio {
                void salvar(@OrcamentoPeriodo orcamento);
                @OrcamentoPeriodo buscarPorId(@OrcamentoId id);
                @OrcamentoPeriodo buscarPorPeriodo(@Periodo periodo);
            }

            DomainService OrcamentoServico {
                @OrcamentoPeriodo criar(@Periodo periodo, BigDecimal valorTotal);
                void reduzir(@OrcamentoId id, BigDecimal novoValor);
                void encerrar(@OrcamentoId id);
            }
        }

        Aggregate DespesaAggregate {
            Entity Despesa {
                aggregateRoot

                @DespesaId id
                @OrcamentoId orcamentoId
                String descricao
                BigDecimal valor
                CategoriaDespesa categoria
                LocalDateTime dataRegistro
            }

            ValueObject DespesaId {
                UUID valor
            }

            ValueObject ResultadoRegistroDespesa {
                @Despesa despesa
                boolean alertaOrcamento
            }

            ValueObject IndicadoresDesempenho {
                BigDecimal taxaOcupacao
                BigDecimal receitaBruta
                BigDecimal receitaLiquida
                BigDecimal totalDespesas
                BigDecimal crescimentoPublico
            }

            ValueObject ComparativoPeriodos {
                @IndicadoresDesempenho periodoAnterior
                @IndicadoresDesempenho periodoAtual
            }

            enum CategoriaDespesa {
                MANUTENCAO, PESSOAL, MARKETING, EQUIPAMENTO, OUTROS
            }

            Repository IDespesaRepositorio {
                void salvar(@Despesa despesa);
                List<@Despesa> buscarPorOrcamento(@OrcamentoId id);
                BigDecimal somarPorOrcamento(@OrcamentoId id);
            }

            DomainService DesempenhoTeatroServico {
                @ResultadoRegistroDespesa registrarDespesa(@OrcamentoId id, String descricao, BigDecimal valor, CategoriaDespesa categoria);
                @IndicadoresDesempenho calcularIndicadores(@Periodo periodo, int capacidadeTotal);
                @ComparativoPeriodos compararPeriodos(@Periodo anterior, @Periodo atual, int capacidadeTotal);
            }
        }
    }
}

// ════════════════════════════════════════════════════════════════════════
//  ArtistaContext (Artista + Produtor)
//  Pacotes Java: dominio-artista/artista, dominio-artista/produtor
// ════════════════════════════════════════════════════════════════════════
BoundedContext ArtistaContext implements RecifeCultural {
    domainVisionStatement = "Cadastro e ciclo de vida de produtores culturais (PJ com CNPJ) e artistas vinculados a eles. Produtor tem trilha de mudanças de status (histórico) e regras de inativação que percorrem artistas ativos via Iterator próprio do domínio. Artista carrega rider técnico iterável item a item."
    type = APPLICATION

    Module ProdutorModule {
        Aggregate ProdutorAggregate {
            Entity Produtor {
                aggregateRoot

                @ProdutorId id
                String nomeFantasia
                @Cnpj cnpj
                String email
                String telefone
                StatusProdutor status

                void atualizarContato(String novoEmail, String novoTelefone);
                void suspender();
                void reativar();
                void inativar();
                void anonimizarDadosPessoais();
            }

            Entity HistoricoStatusProdutor {
                aggregateRoot

                UUID id
                @ProdutorId produtorId
                StatusProdutor statusAnterior
                StatusProdutor statusNovo
                String responsavel
                String motivo
                LocalDateTime dataAlteracao
            }

            ValueObject ProdutorId {
                UUID valor
            }

            ValueObject Cnpj {
                String valor

                String formatado();
            }

            enum StatusProdutor {
                ATIVO, SUSPENSO, INATIVO
            }

            Repository IProdutorRepositorio {
                void salvar(@Produtor produtor);
                void atualizar(@Produtor produtor);
                Optional<@Produtor> obterPorId(@ProdutorId id);
                boolean existePorCnpj(@Cnpj cnpj);
            }

            Repository IHistoricoStatusProdutorRepositorio {
                void salvar(@HistoricoStatusProdutor historico);
                List<@HistoricoStatusProdutor> listarPorProdutor(@ProdutorId produtorId);
            }

            DomainService ProdutorServico {
                @ProdutorId cadastrar(String nomeFantasia, @Cnpj cnpj, String email, String telefone);
                void atualizarContato(@ProdutorId produtorId, String novoEmail, String novoTelefone);
                void suspender(@ProdutorId produtorId, String responsavel, String motivo);
                void reativar(@ProdutorId produtorId, String responsavel, String motivo);
                /*
                 * Usa Iterador<Artista> (criarIteradorPorProdutor) para percorrer
                 * artistas ativos do produtor antes de permitir a inativação.
                 * Se encontrar algum ATIVO, lança IllegalStateException.
                 */
                void inativar(@ProdutorId produtorId, String responsavel, String motivo);
            }
        }
    }

    Module ArtistaModule {

        /*
         * Padrão Iterator — Par 5 · F5.1
         *
         * O grupo implementou um Iterator customizado (sem usar java.util.Iterator)
         * com interface própria do domínio:
         *   Iterador<T>   — boolean temProximo() + T proximo()
         *   Iteravel<T>   — Iterador<T> criarIterador()
         *
         * Duas implementações concretas:
         *   IteradorDeArtistas    — percorre List<Artista>
         *   IteradorDeItensRider  — percorre Set<ItemRider> (converte para array)
         *
         * Expostos via métodos default em IArtistaRepositorio:
         *   criarIteradorPorProdutor(ProdutorId) → Iterador<Artista>
         *   criarIteradorDeItensRider(ArtistaId) → Iterador<ItemRider>
         *
         * Consumidos em:
         *   ProdutorServico.inativar()    → itera artistas para bloquear inativação
         *   ArtistaServico.iterarItensRider() → itera itens do rider
         */

        Aggregate ArtistaAggregate {
            Entity Artista {
                aggregateRoot

                @ArtistaId id
                @ProdutorId produtorId
                String nome
                @RiderTecnico riderTecnico
                StatusArtista status

                void atualizarRider(@RiderTecnico novoRider);
                void inativar();
            }

            ValueObject ArtistaId {
                UUID valor
            }

            ValueObject RiderTecnico {
                Set<ItemRider> itens
            }

            /*
             * Iterador<T> — interface do domínio (sem java.util.Iterator):
             *   boolean temProximo()
             *   T proximo()
             */
            ValueObject Iterador {
                /* type parameter T — boolean temProximo(); T proximo() */
            }

            /*
             * Iteravel<T> — interface do domínio:
             *   Iterador<T> criarIterador()
             */
            ValueObject Iteravel {
                /* type parameter T — Iterador<T> criarIterador() */
            }

            /*
             * IteradorDeArtistas — implementação concreta de Iterador<Artista>
             *   Recebe List<Artista>; percorre com índice inteiro.
             */
            ValueObject IteradorDeArtistas {
                /* implements Iterador<Artista> — boolean temProximo(); Artista proximo() */
            }

            /*
             * IteradorDeItensRider — implementação concreta de Iterador<ItemRider>
             *   Recebe Set<ItemRider>; converte para Object[] para permitir índice.
             */
            ValueObject IteradorDeItensRider {
                /* implements Iterador<ItemRider> — boolean temProximo(); ItemRider proximo() */
            }

            enum StatusArtista {
                ATIVO, INATIVO
            }

            enum ItemRider {
                MICROFONE, MESA_DE_SOM, PROJETOR, PIANO, BATERIA,
                ILUMINACAO_CENA, GERACAO_ENERGIA, CAMARIM, OUTRO
            }

            Repository IArtistaRepositorio {
                void salvar(@Artista artista);
                void atualizar(@Artista artista);
                Optional<@Artista> obterPorId(@ArtistaId id);
                List<@Artista> listarPorProdutor(@ProdutorId produtorId);
                boolean existePorNomeEProdutor(String nome, @ProdutorId produtorId);
                /*
                 * Métodos default — encapsulam a criação dos iteradores concretos:
                 *   criarIteradorPorProdutor  → new IteradorDeArtistas(listarPorProdutor(produtorId))
                 *   criarIteradorDeItensRider → new IteradorDeItensRider(artista.getRiderTecnico().itens())
                 */
                @Iterador criarIteradorPorProdutor(@ProdutorId produtorId);
                @Iterador criarIteradorDeItensRider(@ArtistaId artistaId);
            }

            DomainService ArtistaServico {
                @ArtistaId cadastrar(@ProdutorId produtorId, String nome, @RiderTecnico riderTecnico);
                void atualizarRider(@ArtistaId artistaId, @RiderTecnico novoRider);
                void inativar(@ArtistaId artistaId);
                /* Retorna Iterador<ItemRider> via IArtistaRepositorio.criarIteradorDeItensRider */
                @Iterador iterarItensRider(@ArtistaId artistaId);
            }
        }
    }
}

// ════════════════════════════════════════════════════════════════════════
//  NotificacaoContext
//  Pacote Java: dominio-compartilhado/compartilhado/notificacao
// ════════════════════════════════════════════════════════════════════════
BoundedContext NotificacaoContext implements RecifeCultural {
    domainVisionStatement = "Subdomínio genérico de notificações: envio direto a usuário, broadcast por contexto (PARTICIPANTES_EVENTO_CANCELADO, ACESSIBILIDADE_REMOVIDA, EQUIPAMENTO_MANUTENCAO, PROMOTORES, TODOS_USUARIOS…), marcação como lida e listagem por usuário. Resolução de destinatários para broadcast é feita pelo port IUsuarioContextoServico."
    type = GENERIC_SUBDOMAIN

    Module NotificacaoModule {
        Aggregate NotificacaoAggregate {
            Entity Notificacao {
                aggregateRoot

                @NotificacaoId id
                UUID usuarioAlvo
                String mensagem
                String contexto
                UUID idReferencia
                boolean foiLida
                LocalDateTime dataCriacao

                void marcarComoLida();
                void marcarComoNaoLida();
            }

            ValueObject NotificacaoId {
                UUID valor
            }

            Repository INotificacaoRepositorio {
                boolean salvar(@Notificacao notificacao);
                boolean atualizar(@Notificacao notificacao);
                @Notificacao obter(@NotificacaoId id);
                List<@Notificacao> obterPorUsuario(UUID usuarioAlvo);
                List<@Notificacao> obterNaoLidasPorUsuario(UUID usuarioAlvo);
                List<@Notificacao> obterPorContexto(UUID usuarioAlvo, String contexto);
            }

            DomainService NotificacaoServico {
                void enviarNotificacao(UUID usuarioAlvo, String mensagem);
                void enviarNotificacao(UUID usuarioAlvo, String mensagem, String contexto, UUID idReferencia);
                void enviarBroadcast(String mensagem);
                void enviarBroadcast(String mensagem, String contexto, UUID idReferencia);
                void marcarComoLida(@NotificacaoId id);
                void marcarComoNaoLida(@NotificacaoId id);
                List<@Notificacao> obterNotificacoesDoUsuario(UUID usuarioAlvo);
                List<@Notificacao> obterNotificacoesNaoLidas(UUID usuarioAlvo);
            }

            /*
             * Port resolvido na infraestrutura (UsuarioContextoServicoImpl):
             *   IUsuarioContextoServico {
             *     List<UUID> obterUsuariosPorContexto(String contexto, UUID idReferencia);
             *   }
             *
             * Implementação atual (pre-auth) usa IDs determinísticos por papel.
             */
        }
    }
}

// ════════════════════════════════════════════════════════════════════════
//  AuditoriaContext
//  Pacote Java: dominio-compartilhado/compartilhado/auditoria
// ════════════════════════════════════════════════════════════════════════
BoundedContext AuditoriaContext implements RecifeCultural {
    domainVisionStatement = "Subdomínio genérico de trilha de auditoria. Registros imutáveis (write-once) gravados pelo Decorator EventoRepositorioComAuditoria a cada criação, transição de status ou remoção de evento. A Agenda não conhece a Auditoria — a decoração é montada no Composition Root."
    type = GENERIC_SUBDOMAIN

    Module AuditoriaModule {
        Aggregate RegistroAuditoriaAggregate {
            Entity RegistroAuditoria {
                aggregateRoot

                UUID id
                String entidade
                UUID entidadeId
                AcaoAuditoria acao
                String statusAnterior
                String statusNovo
                String descricao
                LocalDateTime momento
            }

            enum AcaoAuditoria {
                CRIADO, TRANSICAO_STATUS, REMOVIDO
            }

            Repository IAuditoriaRepositorio {
                void registrar(@RegistroAuditoria registro);
                List<@RegistroAuditoria> listarRecentes(int limite);
                List<@RegistroAuditoria> listarPorEntidade(String entidade, int limite);
            }
        }
    }
}
